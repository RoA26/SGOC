# Copia este archivo a `.env` (Spring lo carga automáticamente al arrancar desde esta carpeta).
# En Docker / VPS define estas mismas variables en el entorno del contenedor.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/sgp
DB_USERNAME=sgp
DB_PASSWORD=sgp

# --- JWT ---
# Obligatoria. Genera una con:  openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=1h
JWT_ISSUER=unisen-sgp

# --- Seguridad ---
BCRYPT_STRENGTH=12
# Separados por comas: dominio de producción y Vite en desarrollo.
CORS_ALLOWED_ORIGINS=https://rrtf.duckdns.org,http://localhost:5173

# --- SUPER_ADMIN inicial (se crea al arrancar si su username y su correo no existen) ---
# Operador de la plataforma SaaS: no pertenece a ninguna empresa. Para trabajar con los datos
# de una empresa (soporte) envía la cabecera X-Tenant-ID con el id de la empresa.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nexora.com
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDOS=

# --- Límites de intentos (en memoria, por usuario y por código de empresa; nunca por IP) ---
# Al superarlos: 429 con Retry-After. Cada intento caduca al cumplirse su ventana (30s, 15m, 1h...).
LIMITE_LOGIN_MAX_FALLOS=10
LIMITE_LOGIN_VENTANA=15m
LIMITE_REGISTRO_MAX_POR_CODIGO=20
LIMITE_REGISTRO_VENTANA_POR_CODIGO=1h
LIMITE_REGISTRO_MAX_GLOBAL=200
LIMITE_REGISTRO_VENTANA_GLOBAL=1h
LIMITE_MAX_CLAVES=50000

# --- Otros ---
SERVER_PORT=8081
SWAGGER_ENABLED=true

# =============================================================================
# Variables de docker-compose.yml. Copia a `.env` y rellena las obligatorias (*).
# =============================================================================

# --- Dominio y red ---
APP_DOMAIN=rrtf.duckdns.org
# Puerto publicado por Nginx. Con TLS en el host: HTTP_PORT=127.0.0.1:8080
HTTP_PORT=80

# --- PostgreSQL ---
POSTGRES_DB=sgp
POSTGRES_USER=sgp
# (*) Contraseña de la base de datos
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432

# --- Seguridad JWT ---
# (*) Genera una con:  openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=1h

# --- SUPER_ADMIN inicial (se crea al arrancar si su username y su correo no existen) ---
# Operador de la plataforma SaaS: no pertenece a ninguna empresa. Para trabajar con los datos
# de una empresa (soporte) envía la cabecera X-Tenant-ID con el id de la empresa.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@unisen.com
# (*) Mínimo 8 caracteres
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador

# --- Otros ---
SWAGGER_ENABLED=false
VITE_API_URL=/api

diff --git a/frontend/nginx.conf.template b/frontend/nginx.conf.template
new file mode 100644
index 0000000..7883fe8
--- /dev/null
+++ b/frontend/nginx.conf.template
@@ -0,0 +1,137 @@
+# =============================================================================
+# Nexora - PROPUESTA de capa B (límites por IP en Nginx). NO ESTÁ ACTIVA.
+#
+# Sustituiría a frontend/nginx.conf como plantilla de la imagen oficial de Nginx
+# (/etc/nginx/templates/default.conf.template → /etc/nginx/conf.d/default.conf al arrancar).
+# El entrypoint de la imagen solo sustituye las variables de entorno DEFINIDAS: las de Nginx
+# ($remote_addr, $uri...) quedan intactas. Variables y activación: README.md de esta carpeta.
+#
+# Respecto a frontend/nginx.conf solo cambia:
+#   1. IP real del cliente (realip) desde la dirección de confianza NGINX_PROXY_CONFIANZA.
+#   2. limit_req en POST /api/auth/login y /api/auth/registro (clave: IP real del cliente).
+#   3. 429 propio en Problem Details con Retry-After.
+#   4. X-Forwarded-For hacia el backend: solo la IP ya resuelta (antes se encadenaba lo que
+#      enviara el cliente, y Spring toma la primera, falsificable).
+# Todo lo demás (estáticos, /healthz, SPA, cabeceras de seguridad, 503 en JSON) es igual.
+# =============================================================================
+
+resolver 127.0.0.11 valid=10s ipv6=off;
+
+map $http_x_forwarded_proto $forwarded_proto {
+    default $http_x_forwarded_proto;
+    ''      $scheme;
+}
+
+# --- 1. IP real del cliente ------------------------------------------------
+# Solo se cree X-Forwarded-For si la conexión llega desde la dirección de confianza (el proxy
+# TLS del host, confirmado en el VPS). Con real_ip_recursive se toma la última IP de la cadena
+# que no sea de confianza: la que añadió el proxy. Las que el cliente escriba delante se ignoran.
+# NGINX_PROXY_CONFIANZA no tiene valor por defecto: sin ella Nginx no arranca (falla seguro).
+# Sin proxy delante (Nginx recibe directamente a los clientes), usa 127.0.0.1: nada externo llega
+# desde el loopback del contenedor, así que no se confía en ninguna cabecera.
+set_real_ip_from ${NGINX_PROXY_CONFIANZA};
+real_ip_header X-Forwarded-For;
+real_ip_recursive on;
+
+# --- 2. Límites por IP del cliente -----------------------------------------
+# La clave solo existe en login y registro; en el resto es vacía y no cuenta. Se compara $uri
+# (ya decodificada y con barras unificadas) por prefijo: //login, %6Cogin o login;x no escapan.
+map $uri $limite_login {
+    default "";
+    ~^/api/auth/login $binary_remote_addr;
+}
+map $uri $limite_registro {
+    default "";
+    ~^/api/auth/registro $binary_remote_addr;
+}
+# 10 MB por zona: del orden de 160 000 IP simultáneas.
+limit_req_zone $limite_login    zone=login:10m    rate=${NGINX_LIMITE_LOGIN};
+limit_req_zone $limite_registro zone=registro:10m rate=${NGINX_LIMITE_REGISTRO};
+limit_req_status 429;
+limit_req_log_level warn;
+
+server {
+    listen 80 default_server;
+    server_name rrtf.duckdns.org localhost;
+
+    root /usr/share/nginx/html;
+    index index.html;
+
+    server_tokens off;
+    client_max_body_size 10m;
+
+    # Cabeceras de seguridad (las locations sin add_header las heredan; @demasiados_intentos las repite).
+    add_header X-Content-Type-Options "nosniff" always;
+    add_header X-Frame-Options "DENY" always;
+    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
+    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
+
+    gzip on;
+    gzip_vary on;
+    gzip_min_length 1024;
+    gzip_types text/css application/javascript application/json application/problem+json image/svg+xml;
+
+    # --- API → Spring Boot -------------------------------------------------
+    location /api/ {
+        # Solo cuentan login y registro (clave vacía en el resto). nodelay: la ráfaga se atiende al
+        # momento y, agotada, se rechaza con 429 en vez de encolar.
+        limit_req zone=login    burst=${NGINX_RAFAGA_LOGIN}    nodelay;
+        limit_req zone=registro burst=${NGINX_RAFAGA_REGISTRO} nodelay;
+        # "on": solo se registra lo que se habría rechazado (para la puesta en marcha).
+        limit_req_dry_run ${NGINX_LIMITE_MODO_PRUEBA};
+
+        set $backend ${NGINX_BACKEND};
+        proxy_pass $backend;
+        proxy_http_version 1.1;
+
+        proxy_set_header Host              $host;
+        proxy_set_header X-Real-IP         $remote_addr;
+        # Solo la IP ya resuelta por realip: el backend no recibe lo que escriba el cliente.
+        proxy_set_header X-Forwarded-For   $remote_addr;
+        proxy_set_header X-Forwarded-Proto $forwarded_proto;
+        proxy_set_header X-Forwarded-Host  $host;
+        proxy_set_header Connection        "";
+
+        proxy_connect_timeout 5s;
+        proxy_read_timeout    60s;
+
+        error_page 502 503 504 = @api_unavailable;
+        error_page 429 = @demasiados_intentos;
+    }
+
+    location @api_unavailable {
+        default_type application/problem+json;
+        return 503 '{"type":"about:blank","title":"Servicio no disponible","status":503,"detail":"El servidor no está disponible en este momento. Inténtalo de nuevo en unos minutos."}';
+    }
+
+    # --- 3. Límite por IP superado: mismo formato que el 429 del backend ------
+    location @demasiados_intentos {
+        default_type application/problem+json;
+        add_header Retry-After "${NGINX_RETRY_AFTER}" always;
+        add_header X-Content-Type-Options "nosniff" always;
+        add_header X-Frame-Options "DENY" always;
+        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
+        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
+        return 429 '{"type":"about:blank","title":"Demasiados intentos","status":429,"detail":"Demasiadas peticiones desde tu conexión. Espera un momento e inténtalo de nuevo.","reintentarEnSegundos":${NGINX_RETRY_AFTER}}';
+    }
+
+    # --- Healthcheck del contenedor (sin límites) --------------------------
+    location = /healthz {
+        access_log off;
+        default_type text/plain;
+        return 200 "ok\n";
+    }
+
+    # --- Estáticos con hash en el nombre: caché de larga duración -------------
+    location /assets/ {
+        expires 1y;
+        access_log off;
+        try_files $uri =404;
+    }
+
+    # --- SPA: cualquier otra ruta sirve index.html (React Router) -----------
+    location / {
+        expires -1;
+        try_files $uri $uri/ /index.html;
+    }
+}

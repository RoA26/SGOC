# Bastión · __DOMINIO__ · generado por deploy/scripts/bastion-vps.sh
# Sitio NUEVO para el Nginx del servidor. Solo HTTP: el certificado lo añade después
#   sudo certbot --nginx -d __DOMINIO__ --redirect
# que modifica únicamente este bloque.
server {
    listen 80;
    server_name __DOMINIO__;
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:__PUERTO__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

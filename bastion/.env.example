# Copie a .env y complete. Nunca suba .env al repositorio.
# Genere secretos con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BASTION_DB_PASSWORD=
BASTION_JWT_SECRET=
BASTION_JWT_EXPIRE_MINUTES=30
# Puerto local (solo 127.0.0.1) al que apunta el Nginx del servidor. Verifique que esté libre.
BASTION_HTTP_PORT=8090
BASTION_VERSION=latest

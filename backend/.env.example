# Copia este archivo a `.env` y ajusta los valores.

ENVIRONMENT=development

# PostgreSQL (driver asíncrono asyncpg). Coincide con docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://sgoc:sgoc@localhost:5432/sgoc
DATABASE_ECHO=false

# Genera una clave segura con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Coste de bcrypt (4-31). 12 es un buen equilibrio para producción.
BCRYPT_ROUNDS=12

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173
